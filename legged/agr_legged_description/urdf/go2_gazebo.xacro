<?xml version="1.0"?>
<!-- Gazebo + ros2_control wiring for the Go2. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Feet need real friction or the robot skates. Everything else is
       ordinary. mu 0.8 is the value the official description uses. -->
  <xacro:macro name="foot_surface" params="name">
    <gazebo reference="${name}_foot">
      <mu1>0.8</mu1><mu2>0.8</mu2>
      <kp>1000000.0</kp><kd>100.0</kd>
      <self_collide>false</self_collide>
    </gazebo>
  </xacro:macro>
  <xacro:foot_surface name="FL"/>
  <xacro:foot_surface name="FR"/>
  <xacro:foot_surface name="RL"/>
  <xacro:foot_surface name="RR"/>

  <gazebo reference="base_link"><self_collide>false</self_collide></gazebo>

  <!-- ── ros2_control: 12 position-controlled joints ────────────────────
       Position control, not effort. A torque-controlled quadruped needs a
       real locomotion controller to stand up at all; position control lets
       the robot hold a stance and move between poses, which is what the
       bringup and the labs need. Swap to effort interfaces when a
       locomotion stack (champ, OCS2, RL policy) is plugged in.            -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- initial_value matters more than it looks. gz_ros2_control seeds the
         joint at this angle the moment the model spawns, and the robot then
         rests on its feet for the ~10 s it takes joint_state_broadcaster and
         the position controller to come up. Without it every joint starts at
         0 - legs straight down, 0.446 m of stilts - and NOTHING holds them:
         the Go2 collapses and lands on its back long before the controller
         can issue a command. Keep these equal to STAND in stand.py.        -->
    <xacro:macro name="leg_ctrl" params="name">
      <joint name="${name}_hip_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${name}_thigh_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.80</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${name}_calf_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">-1.55</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:leg_ctrl name="FL"/>
    <xacro:leg_ctrl name="FR"/>
    <xacro:leg_ctrl name="RL"/>
    <xacro:leg_ctrl name="RR"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find agr_legged_bringup)/config/go2_controllers.yaml</parameters>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
  </gazebo>

  <!-- IMU on the trunk — a legged robot without one has no idea which way is up. -->
  <link name="imu_link">
    <inertial><mass value="0.01"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on><update_rate>200</update_rate>
      <topic>imu</topic>
    </sensor>
  </gazebo>

  <!-- ── Front camera ──────────────────────────────────────────────────
       Without this the Go2 has an IMU and nothing else, so every perception
       exercise has to be written for a different platform.

       The <pose> is relative to the head link, which sdformat then folds into
       base_link when it collapses the fixed joint (verified with `gz sdf -p`:
       the sensor comes out at 0.208 0 0.08 in the trunk frame). Mounting it
       ABOVE the trunk rather than on its front face matters - at trunk height
       the robot's own front legs swing through the lower corners of every
       frame.

       Pitch is 3 deg down, not the 10 deg that seems natural for a walking
       robot. At 10 deg the horizon sits 32% down the image and the remaining
       two thirds is featureless ground plane; the picture is technically
       correct and useless to look at. MEASURED by rendering both.

       640x480 at 15 Hz is deliberately modest: rendering is the single most
       expensive thing in this sim, and a legged contact solver already wants
       a 500 Hz physics loop.                                               -->
  <gazebo reference="head">
    <sensor name="front_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <topic>front_camera</topic>
      <pose>0.02 0 0.06 0 0.05 0</pose>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>50.0</far></clip>
      </camera>
    </sensor>
  </gazebo>
</robot>
