<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agr_arm_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and ROS 2 &lt;-&gt; Gazebo bridge for the bench-mounted UR5e arm.</description>
  <maintainer email="anis.koubaa@gmail.com">Anis Koubaa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>agr_arm_description</exec_depend>
  <exec_depend>agr_arm_worlds</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
