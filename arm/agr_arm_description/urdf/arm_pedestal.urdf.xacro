<?xml version="1.0"?>
<!-- Author: Prof. Anis Koubaa <anis.koubaa@gmail.com> -->
<!--
  Bench pedestal for the UR5e.

  This is the one structural difference between the arm platform and the
  ground platform: RaiseBot carries the same UR5e on a Husky, so its base is
  free to drive away. Here the base is BOLTED DOWN, and that single fact
  changes the whole problem:

    - the robot has no odometry, no /cmd_vel and no navigation. Its entire
      state is six joint angles.
    - the world frame and the robot base frame are the same thing forever,
      so a Cartesian target in metres means one unambiguous arm configuration
      (a "workspace" you can draw on the table), not a moving target.
    - anything the arm cannot reach, it cannot reach. On the Husky you drive
      closer; here you have hit the edge of an 850 mm sphere and the honest
      answer is "unreachable".

  How it is bolted down: URDF has no notion of "static". The convention every
  URDF→SDF converter honours is a link literally named `world` with a fixed
  joint to it, which sdformat turns into a joint against the world entity.
  Drop that joint and the pedestal is a free body that tips over the instant
  the arm accelerates.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_pedestal" params="height:=0.75 radius:=0.09">

    <!-- The world anchor. Massless and geometry-free on purpose: it exists
         only to give the fixed joint below something to attach to. -->
    <link name="world"/>

    <joint name="world_to_pedestal" type="fixed">
      <parent link="world"/>
      <child link="pedestal_link"/>
      <origin xyz="0 0 ${height/2}" rpy="0 0 0"/>
    </joint>

    <link name="pedestal_link">
      <visual>
        <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
        <material name="pedestal_grey"><color rgba="0.30 0.31 0.34 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${radius}" length="${height}"/></geometry>
      </collision>
      <inertial>
        <mass value="40.0"/>
        <inertia ixx="2.0" ixy="0" ixz="0" iyy="2.0" iyz="0" izz="0.2"/>
      </inertial>
    </link>

    <!-- Mounting flange on top — this is what the UR5e bolts to, and its top
         face is z = ${height} + 0.01 in the world frame. Every Cartesian
         number in agr_arm_tools is measured from the world origin at the
         floor, so this offset is the one constant that ties joint space to
         "height above the bench". -->
    <joint name="pedestal_to_base_plate" type="fixed">
      <parent link="pedestal_link"/>
      <child link="base_plate"/>
      <origin xyz="0 0 ${height/2 + 0.005}" rpy="0 0 0"/>
    </joint>

    <link name="base_plate">
      <visual>
        <geometry><cylinder radius="0.11" length="0.01"/></geometry>
        <material name="plate_grey"><color rgba="0.55 0.56 0.58 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.11" length="0.01"/></geometry>
      </collision>
      <inertial>
        <mass value="2.0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
      </inertial>
    </link>

  </xacro:macro>

</robot>
