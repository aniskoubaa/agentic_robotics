<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agr_arm_demos</name>
  <version>0.1.0</version>
  <description>Diagnostics and the pick-and-place showcase for the bench UR5e.</description>
  <maintainer email="anis.koubaa@gmail.com">Anis Koubaa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>agr_arm_tools</exec_depend>
  <exec_depend>agr_arm_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
