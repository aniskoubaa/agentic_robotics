#!/usr/bin/env bash
# Author: Prof. Anis Koubaa <anis.koubaa@gmail.com>
# Agentic Robotics — launch a UAV simulation with every environment fix applied.
#
# Modelled on AgriBot's `raise-sim`. The whole point is that you type
# `agr-sim` and nothing else: no sourcing, no PATH surgery, no remembering
# which python is which.
#
# Five environment hazards handled here, all of which cost an afternoon each:
#
#   1. ANACONDA. If anaconda is on PATH, `python3` is its interpreter (3.11 on
#      this machine) while ROS 2 Jazzy is built for the system 3.12. ROS's
#      python modules — `em`, `catkin_pkg`, `rosidl` — are invisible to it, so
#      builds die with "No module named 'em'" and nodes fail to import rclpy.
#      Stripped from PATH here, along with CONDA_*.
#
#   2. VS Code snap terminals inject GTK / locale paths that load the wrong
#      libpthread on Ubuntu 24.04, so `gz sim gui` dies with a symbol lookup
#      error. Stripped.
#
#   3. Hybrid Intel iGPU + NVIDIA dGPU laptops route OpenGL to Intel, and
#      Gazebo Harmonic's Ogre2 hangs at GL context creation. PRIME offload is
#      applied when an NVIDIA card is present.
#
#   4. Ubuntu 24.04 defaults to Wayland, where Gazebo's Qt GUI often hangs on a
#      blank window. Forced to the xcb (X11/XWayland) backend when the session
#      is Wayland; pure-X11 setups are untouched.
#
#   5. PX4's binary resolves libgz-*.so from the ROS vendor Gazebo under
#      /opt/ros/<distro>/opt/gz_*_vendor/. Sourcing ROS here is what puts them
#      on LD_LIBRARY_PATH — without it PX4 exits with
#      "error while loading shared libraries: libgz-utils2.so.2".
#
# Usage:
#   agr-sim                                   # UAV: one x500, GUI
#   agr-sim world:=agr_defense                # UAV: any single.launch.py arg
#   agr-sim uav airframe:=rc_cessna           # UAV, explicitly
#   agr-sim uav --multi count:=3              # UAV: three vehicles
#   agr-sim ground                            # GROUND: Husky in the greenhouse
#   agr-sim ground world:=greenhouse_2026_lite.sdf
#   agr-stop                                  # tear down whichever is running
#
# The platform word is optional and defaults to `uav`, so existing UAV commands
# keep working unchanged.
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "${SCRIPT_PATH}")"

# $HOME/$USER come from a LOGIN shell; ssh-with-a-command and cron have neither.
RUN_HOME="${HOME:-$(getent passwd "$(id -un)" | cut -d: -f6)}"
RUN_USER="${USER:-$(id -un)}"

AGR_WS="${AGR_WS:-${RUN_HOME}/ros2_ws}"
AGR_ROS_DISTRO="${AGR_ROS_DISTRO:-jazzy}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  sed -n '2,34p' "$SCRIPT_PATH" | sed 's/^#\s\?//'; exit 0
fi

# ── platform dispatch ───────────────────────────────────────────────────────
# UAV and ground are entirely separate stacks: different simulator entry point
# (PX4 owns Gazebo for UAV; ros_gz spawns for ground), different robots,
# different labs. They share only agr_core and this wrapper, which is the whole
# point of keeping them in separate subtrees. Nothing here loads the other
# platform's packages.
PLATFORM="uav"
case "${1:-}" in
  uav|ground) PLATFORM="$1"; shift ;;
esac

if [[ "$PLATFORM" == "ground" ]]; then
  LAUNCH_PKG="agribot_bringup"
  LAUNCH_FILE="sim.launch.py"
  [[ "${1:-}" == "--world-only" ]] && { LAUNCH_FILE="world_only.launch.py"; shift; }
else
  LAUNCH_PKG="agr_uav_bringup"
  LAUNCH_FILE="single.launch.py"
  [[ "${1:-}" == "--multi" ]] && { LAUNCH_FILE="multi.launch.py"; shift; }
fi

if [[ ! -f "${AGR_WS}/install/setup.bash" ]]; then
  cat >&2 <<EOF
✗ Workspace not built at ${AGR_WS}.
  Build it with:   ${SCRIPT_DIR}/setup.sh
  Or point elsewhere:  AGR_WS=/path/to/ws agr-sim
EOF
  exit 1
fi

# ── env vars to unset (snap + anaconda injections) ──────────────────────────
SNAP_VARS=(
  GTK_PATH GTK_EXE_PREFIX GTK_IM_MODULE_FILE
  GIO_MODULE_DIR LOCPATH
  GSETTINGS_SCHEMA_DIR GSETTINGS_SCHEMA_DIR_CONDA_BACKUP
  XDG_DATA_HOME XDG_CONFIG_HOME XDG_CACHE_HOME
  VSCODE_GIT_ASKPASS_NODE VSCODE_GIT_ASKPASS_MAIN VSCODE_GIT_IPC_HANDLE
  GIT_ASKPASS VSCODE_INJECTION VSCODE_IPC_HOOK_CLI ELECTRON_RUN_AS_NODE
)
CONDA_VARS=(CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_PROMPT_MODIFIER CONDA_SHLVL CONDA_EXE)
# PYTHONPATH is dropped too: a stale one from ANOTHER colcon workspace puts that
# workspace's python packages ahead of this one's, and you debug the wrong code.
# Sourcing ROS + this workspace below rebuilds it correctly.
OTHER_VARS=(PYTHONPATH)

unset_args=()
for v in "${SNAP_VARS[@]}" "${CONDA_VARS[@]}" "${OTHER_VARS[@]}"; do unset_args+=(-u "$v"); done

# ── conditional NVIDIA PRIME offload ────────────────────────────────────────
PRIME_VARS=()
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L 2>/dev/null | grep -q GPU; then
  PRIME_VARS=(__NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia
              __VK_LAYER_NV_optimus=NVIDIA_only)
fi

# ── conditional Wayland → xcb ───────────────────────────────────────────────
QT_VARS=()
if [[ "${XDG_SESSION_TYPE:-}" == "wayland" || -n "${WAYLAND_DISPLAY:-}" ]]; then
  QT_VARS=(QT_QPA_PLATFORM=xcb)
fi

strip_paths() { echo "${1:-}" | tr ':' '\n' | grep -vE '/snap/|anaconda|miniconda' | paste -sd:; }
strip_snap()  { echo "${1:-}" | tr ':' '\n' | grep -v '/snap/'                     | paste -sd:; }

exec env "${unset_args[@]}" \
    PATH="$(strip_paths "${PATH:-/usr/bin:/bin}")" \
    LD_LIBRARY_PATH="$(strip_snap "${LD_LIBRARY_PATH:-}")" \
    XDG_DATA_DIRS="$(strip_snap "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}")" \
    DISPLAY="${DISPLAY:-:0}" \
    XAUTHORITY="${XAUTHORITY:-/run/user/$(id -u)/gdm/Xauthority}" \
    HOME="${RUN_HOME}" USER="${RUN_USER}" \
    AGR_WS="${AGR_WS}" AGR_ROS_DISTRO="${AGR_ROS_DISTRO}" \
    LAUNCH_PKG="${LAUNCH_PKG}" LAUNCH_FILE="${LAUNCH_FILE}" \
    "${PRIME_VARS[@]}" "${QT_VARS[@]}" \
  bash -c '
    set +u
    source "/opt/ros/${AGR_ROS_DISTRO}/setup.bash"
    source "${AGR_WS}/install/setup.bash"
    exec ros2 launch "${LAUNCH_PKG}" "${LAUNCH_FILE}" "$@"
  ' bash "$@"
