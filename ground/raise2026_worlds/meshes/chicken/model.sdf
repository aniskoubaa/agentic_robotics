<?xml version="1.0"?>
<!-- Author: Prof. Anis Koubaa <anis.koubaa@gmail.com> -->
<sdf version="1.10">
  <model name="chicken">
    <static>true</static>

    <!-- Body (slightly squat egg shape) -->
    <link name="body">
      <pose>0 0 0.22 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.14</radius></sphere></geometry>
        <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <collision name="c"><geometry><sphere><radius>0.14</radius></sphere></geometry></collision>
    </link>

    <!-- Tail (raised back lump) -->
    <link name="tail">
      <pose>-0.12 0 0.32 0 -0.5 0</pose>
      <visual name="v"><geometry><sphere><radius>0.07</radius></sphere></geometry>
        <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material>
      </visual>
    </link>

    <!-- Neck + head -->
    <link name="neck">
      <pose>0.10 0 0.32 0 -0.4 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.030</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material>
      </visual>
    </link>
    <link name="head">
      <pose>0.15 0 0.38 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.06</radius></sphere></geometry>
        <material><ambient>0.85 0.83 0.78 1</ambient><diffuse>0.95 0.93 0.88 1</diffuse></material>
      </visual>
    </link>

    <!-- Red comb -->
    <link name="comb">
      <pose>0.15 0 0.45 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.65 0.10 0.10 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <!-- Wattle (under beak) -->
    <link name="wattle">
      <pose>0.17 0 0.34 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.65 0.10 0.10 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse></material>
      </visual>
    </link>

    <!-- Orange beak (cone-like via small box rotated) -->
    <link name="beak">
      <pose>0.20 0 0.38 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.045 0.020 0.015</size></box></geometry>
        <material><ambient>0.85 0.55 0.10 1</ambient><diffuse>1.0 0.68 0.14 1</diffuse></material>
      </visual>
    </link>

    <!-- Eyes -->
    <link name="eye_l">
      <pose>0.175 0.040 0.395 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.008</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="eye_r">
      <pose>0.175 -0.040 0.395 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.008</radius></sphere></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- Yellow legs -->
    <link name="leg_l">
      <pose>0.04 0.05 0.06 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.012</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.85 0.55 0.10 1</ambient><diffuse>1.0 0.68 0.14 1</diffuse></material>
      </visual>
    </link>
    <link name="leg_r">
      <pose>0.04 -0.05 0.06 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.012</radius><length>0.12</length></cylinder></geometry>
        <material><ambient>0.85 0.55 0.10 1</ambient><diffuse>1.0 0.68 0.14 1</diffuse></material>
      </visual>
    </link>

    <joint name="j_tail"  type="fixed"><parent>body</parent><child>tail</child></joint>
    <joint name="j_neck"  type="fixed"><parent>body</parent><child>neck</child></joint>
    <joint name="j_head"  type="fixed"><parent>body</parent><child>head</child></joint>
    <joint name="j_comb"  type="fixed"><parent>body</parent><child>comb</child></joint>
    <joint name="j_watt"  type="fixed"><parent>body</parent><child>wattle</child></joint>
    <joint name="j_beak"  type="fixed"><parent>body</parent><child>beak</child></joint>
    <joint name="j_el"    type="fixed"><parent>body</parent><child>eye_l</child></joint>
    <joint name="j_er"    type="fixed"><parent>body</parent><child>eye_r</child></joint>
    <joint name="j_ll"    type="fixed"><parent>body</parent><child>leg_l</child></joint>
    <joint name="j_lr"    type="fixed"><parent>body</parent><child>leg_r</child></joint>
  </model>
</sdf>
