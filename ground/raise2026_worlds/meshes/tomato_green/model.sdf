<?xml version="1.0"?>
<!-- Author: Prof. Anis Koubaa <anis.koubaa@gmail.com> -->
<!--
  Graspable UNRIPE (green) tomato — the distractor for "pick the red tomato".
  Identical geometry to tomato_red; only the color differs, so the policy must
  ground the word "red"/"ripe", not just grab the nearest blob.
-->
<sdf version="1.10">
  <model name="tomato_green">
    <link name="fruit">
      <!-- Gravity OFF — see tomato_red: stays where spawned (no table needed). -->
      <gravity>false</gravity>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>2.45e-5</ixx><iyy>2.45e-5</iyy><izz>2.45e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="v">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material>
          <ambient>0.14 0.40 0.11 1</ambient>
          <diffuse>0.22 0.60 0.16 1</diffuse>
        </material>
      </visual>
      <collision name="c">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
      </collision>
    </link>
  </model>
</sdf>
