<model>
  <name>RAISE 2026 Graspable Tomato (green / unripe)</name>
  <version>0.1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>
    A standalone, dynamic, graspable tomato (unripe = green). The DISTRACTOR in
    "pick the red tomato" — the VLA must learn to leave it. Same shape as
    tomato_red, different color, so selection is purely about ripeness.
  </description>
</model>
