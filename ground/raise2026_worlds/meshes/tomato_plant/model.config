<model>
  <name>RAISE 2026 Tomato Plant</name>
  <version>0.1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>
    Minimal tomato plant: stem + foliage + one ripe fruit + one unripe fruit.
    Inline SDF primitives, no textures — students see ripe (red) vs unripe (green-yellow)
    purely from material colors. Replace with realistic meshes once the pipeline works.
  </description>
</model>
