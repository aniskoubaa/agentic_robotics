<?xml version="1.0"?>
<!-- Author: Prof. Anis Koubaa <anis.koubaa@gmail.com> -->
<model>
  <name>RAISE 2026 Graspable Tomato (red / ripe)</name>
  <version>0.1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <description>
    A standalone, dynamic, graspable tomato (ripe = red). Unlike the fruit links
    on the static tomato_plant, this is its OWN model so it can be spawned at
    runtime and carried by the gripper (the grasp_server set_pose-follows it).
    Used by the Day-2 auto-demonstrator to build pick-and-place datasets.
  </description>
</model>
