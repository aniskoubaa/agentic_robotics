<?xml version="1.0"?>
<!-- Author: Prof. Anis Koubaa <anis.koubaa@gmail.com> -->
<!--
  RAISE 2026 — Sfax-style agroforestry plot.

  Open semi-arid field, "harth" (tilled sandy) soil, with:
    - Olive grove to the NORTH (Y > 0)        — 4 trees, spaced along X = {-6, -2, 2, 6}
    - Fig grove  to the SOUTH (Y < 0)         — 4 trees, spaced along X = {-6, -2, 2, 6}
    - Tomato alley in the MIDDLE             — 3 rows × 5 plants at Y = {-2, 0, 2}, X = {-2..2}
    - Husky drives the alleys at Y = ±1.
    - Spawn:  X = -3, Y = +1 (entering from the west).

  The <world> name stays "greenhouse_2026" so launch files and gz_bridge
  topics don't need to be updated.
-->
<sdf version="1.10">
  <world name="greenhouse_2026">

    <!-- GUI config so the 3D window always loads. Without this, Gazebo relies on
         the user's cached ~/.gz/sim/8/gui.config, and a stale/empty cache shows
         "Insert plugins to start!" with no scene. (Reported by RAISE 2026 students.) -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 0 6 0 0.5 0</camera_pose>
        <camera_clip><near>0.25</near><far>25000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <play_pause>true</play_pause><step>true</step><start_paused>false</start_paused><use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations><use_event>true</use_event>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
    </gui>


    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ── Sfax atmosphere: bright sun, dust haze sky ──────────────── -->
    <scene>
      <ambient>0.60 0.55 0.45 1</ambient>
      <background>0.86 0.80 0.68 1</background>     <!-- dusty Mediterranean haze -->
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>1.00 0.93 0.75 1</diffuse>           <!-- strong warm sun -->
      <specular>0.50 0.42 0.30 1</specular>
      <attenuation><range>1200</range><constant>0.85</constant><linear>0.01</linear></attenuation>
      <direction>-0.3 -0.4 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <light type="directional" name="fill_light">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.32 0.28 0.20 1</diffuse>
      <direction>0.4 0.3 -0.7</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ── "Harth" — sandy tilled soil, light ochre Sfax tone ──────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.70 0.58 0.42 1</ambient>
            <diffuse>0.86 0.74 0.56 1</diffuse>
            <specular>0.03 0.03 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Subtle tilled-furrow stripes parallel to the tomato rows ─ -->
    <!-- Three darker thin strips just OFFSET from each plant row,    -->
    <!-- suggesting cultivated/tilled soil under the crops.            -->
    <model name="furrow_strips">
      <static>true</static>
      <link name="strip_row_0_north">
        <pose>0 -2.85 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>9.0 0.15 0.004</size></box></geometry>
          <material><ambient>0.50 0.40 0.28 1</ambient><diffuse>0.62 0.50 0.36 1</diffuse></material>
        </visual>
      </link>
      <link name="strip_row_0_south">
        <pose>0 -3.15 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>9.0 0.15 0.004</size></box></geometry>
          <material><ambient>0.50 0.40 0.28 1</ambient><diffuse>0.62 0.50 0.36 1</diffuse></material>
        </visual>
      </link>
      <link name="strip_row_1_north">
        <pose>0  0.15 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>9.0 0.15 0.004</size></box></geometry>
          <material><ambient>0.50 0.40 0.28 1</ambient><diffuse>0.62 0.50 0.36 1</diffuse></material>
        </visual>
      </link>
      <link name="strip_row_1_south">
        <pose>0 -0.15 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>9.0 0.15 0.004</size></box></geometry>
          <material><ambient>0.50 0.40 0.28 1</ambient><diffuse>0.62 0.50 0.36 1</diffuse></material>
        </visual>
      </link>
      <link name="strip_row_2_north">
        <pose>0  3.15 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>9.0 0.15 0.004</size></box></geometry>
          <material><ambient>0.50 0.40 0.28 1</ambient><diffuse>0.62 0.50 0.36 1</diffuse></material>
        </visual>
      </link>
      <link name="strip_row_2_south">
        <pose>0  2.85 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>9.0 0.15 0.004</size></box></geometry>
          <material><ambient>0.50 0.40 0.28 1</ambient><diffuse>0.62 0.50 0.36 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- TOMATO ALLEY  — 3 rows × 5 plants                            -->
    <!-- Mix: 11 healthy / 2 wilted / 2 diseased — for VLA training   -->
    <!--                                                               -->
    <!-- SPACING (chosen for navigability): rows 3 m apart (y=-3,0,+3) -->
    <!-- and plants 2 m apart along each row (x=-4..+4). This leaves   -->
    <!-- 1.5 m-clear DRIVE AISLES at y=±1.5 — a 0.67 m Husky has ~1.2 m -->
    <!-- margin, so simple reactive navigation works reliably. (The    -->
    <!-- earlier 1 m grid was too dense for anything but a planner.)   -->
    <!--   Row 0 (S, y=-3): H  H  H  H  W                              -->
    <!--   Row 1 (M, y= 0): H  D  H  H  W                              -->
    <!--   Row 2 (N, y=+3): H  H  D  H  H                              -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Row 0: y = -3.0 -->
    <include><name>tomato_0_0</name><pose>-4.0 -3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_0_1</name><pose>-2.0 -3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_0_2</name><pose> 0.0 -3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_0_3</name><pose> 2.0 -3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_0_4</name><pose> 4.0 -3.0 0 0 0 0</pose><uri>model://tomato_plant_wilted</uri></include>

    <!-- Row 1: y = 0.0 -->
    <include><name>tomato_1_0</name><pose>-4.0  0.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_1_1</name><pose>-2.0  0.0 0 0 0 0</pose><uri>model://tomato_plant_diseased</uri></include>
    <include><name>tomato_1_2</name><pose> 0.0  0.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_1_3</name><pose> 2.0  0.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_1_4</name><pose> 4.0  0.0 0 0 0 0</pose><uri>model://tomato_plant_wilted</uri></include>

    <!-- Row 2: y = 3.0 -->
    <include><name>tomato_2_0</name><pose>-4.0  3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_2_1</name><pose>-2.0  3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_2_2</name><pose> 0.0  3.0 0 0 0 0</pose><uri>model://tomato_plant_diseased</uri></include>
    <include><name>tomato_2_3</name><pose> 2.0  3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>
    <include><name>tomato_2_4</name><pose> 4.0  3.0 0 0 0 0</pose><uri>model://tomato_plant</uri></include>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- OLIVE GROVE — north side (Y = +8), 4 trees                  -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <include><name>olive_n1</name><pose>-6.0 8.0 0 0 0  0.3</pose><uri>model://olive_tree</uri></include>
    <include><name>olive_n2</name><pose>-2.0 8.5 0 0 0 -0.5</pose><uri>model://olive_tree</uri></include>
    <include><name>olive_n3</name><pose> 2.0 7.8 0 0 0  1.1</pose><uri>model://olive_tree</uri></include>
    <include><name>olive_n4</name><pose> 6.0 8.3 0 0 0 -0.2</pose><uri>model://olive_tree</uri></include>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- FIG GROVE — south side (Y = -8), 4 trees                    -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <include><name>fig_s1</name><pose>-6.0 -8.0 0 0 0  0.7</pose><uri>model://fig_tree</uri></include>
    <include><name>fig_s2</name><pose>-2.0 -8.5 0 0 0 -0.4</pose><uri>model://fig_tree</uri></include>
    <include><name>fig_s3</name><pose> 2.0 -7.8 0 0 0  1.3</pose><uri>model://fig_tree</uri></include>
    <include><name>fig_s4</name><pose> 6.0 -8.2 0 0 0 -0.8</pose><uri>model://fig_tree</uri></include>

    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- FREE-RANGE BIRDS — chickens + ducks foraging in the plot     -->
    <!--   Spread out so the Husky has to see them while traversing   -->
    <!-- ════════════════════════════════════════════════════════════ -->
    <!-- Chickens (2) — one near olive grove, one in the alley -->
    <include><name>chicken_1</name><pose>-4.5  5.0 0 0 0  0.6</pose><uri>model://chicken</uri></include>
    <include><name>chicken_2</name><pose> 3.5  1.0 0 0 0 -1.8</pose><uri>model://chicken</uri></include>

    <!-- Ducks (2) — one near fig grove, one between rows 0 and 1 -->
    <include><name>duck_1</name><pose> 4.5 -5.5 0 0 0  2.4</pose><uri>model://duck</uri></include>
    <include><name>duck_2</name><pose>-3.2 -1.0 0 0 0  0.3</pose><uri>model://duck</uri></include>

  </world>
</sdf>
