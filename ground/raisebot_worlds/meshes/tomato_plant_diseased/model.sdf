<?xml version="1.0"?>
<!-- Author: Prof. Anis Koubaa <anis.koubaa@gmail.com> -->
<sdf version="1.10">
  <model name="tomato_plant_diseased">
    <static>true</static>

    <link name="pot">
      <pose>0 0 0.075 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.13</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.30 0.20 0.13 1</ambient><diffuse>0.45 0.28 0.18 1</diffuse></material>
      </visual>
      <collision name="c"><geometry><cylinder><radius>0.13</radius><length>0.15</length></cylinder></geometry></collision>
    </link>
    <link name="pot_soil">
      <pose>0 0 0.148 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.115</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.18 0.13 0.08 1</ambient><diffuse>0.25 0.18 0.12 1</diffuse></material>
      </visual>
    </link>

    <link name="stake">
      <pose>0 0 0.85 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.012</radius><length>1.4</length></cylinder></geometry>
        <material><ambient>0.35 0.25 0.15 1</ambient><diffuse>0.55 0.40 0.25 1</diffuse></material>
      </visual>
    </link>

    <!-- Stem (greener at base, brown at top — typical late blight progression) -->
    <link name="stem_lower">
      <pose>0.015 0 0.40 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.018</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.14 0.30 0.10 1</ambient><diffuse>0.20 0.48 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="stem_upper">
      <pose>-0.015 0.010 0.95 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.55</length></cylinder></geometry>
        <material><ambient>0.30 0.25 0.10 1</ambient><diffuse>0.45 0.38 0.15 1</diffuse></material>
      </visual>
    </link>

    <!-- Mostly green leaves with one brown patch — disease in progress -->
    <link name="leaves_healthy_l">
      <pose>-0.15 0.08 0.65 0 0.4 0.3</pose>
      <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.14 0.36 0.11 1</ambient><diffuse>0.20 0.55 0.16 1</diffuse></material>
      </visual>
    </link>
    <link name="leaves_healthy_r">
      <pose>0.16 -0.05 0.70 0 -0.4 -0.2</pose>
      <visual name="v"><geometry><sphere><radius>0.13</radius></sphere></geometry>
        <material><ambient>0.14 0.36 0.11 1</ambient><diffuse>0.20 0.55 0.16 1</diffuse></material>
      </visual>
    </link>
    <link name="leaves_blighted">
      <pose>-0.12 -0.08 1.00 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.30 0.32 0.10 1</ambient><diffuse>0.45 0.42 0.15 1</diffuse></material>     <!-- yellow-green -->
      </visual>
    </link>
    <link name="leaves_top">
      <pose>0.00 0.00 1.30 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.14</radius></sphere></geometry>
        <material><ambient>0.16 0.40 0.12 1</ambient><diffuse>0.22 0.58 0.18 1</diffuse></material>
      </visual>
    </link>

    <!-- Dark blight spots on the leaves (small dark spheres) -->
    <link name="spot_1"><pose>-0.12 0.10 0.66 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.020</radius></sphere></geometry>
        <material><ambient>0.10 0.06 0.04 1</ambient><diffuse>0.15 0.08 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="spot_2"><pose>-0.18 0.04 0.67 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.018</radius></sphere></geometry>
        <material><ambient>0.10 0.06 0.04 1</ambient><diffuse>0.15 0.08 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="spot_3"><pose>0.18 -0.04 0.71 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.022</radius></sphere></geometry>
        <material><ambient>0.10 0.06 0.04 1</ambient><diffuse>0.15 0.08 0.05 1</diffuse></material>
      </visual>
    </link>

    <!-- Aphid cluster (tiny yellowish dots on a leaf) — VLA target class "pest" -->
    <link name="aphid_a"><pose>0.13 -0.02 0.72 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.005</radius></sphere></geometry>
        <material><ambient>0.55 0.50 0.10 1</ambient><diffuse>0.75 0.68 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="aphid_b"><pose>0.14 -0.05 0.71 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.005</radius></sphere></geometry>
        <material><ambient>0.55 0.50 0.10 1</ambient><diffuse>0.75 0.68 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="aphid_c"><pose>0.15 -0.03 0.73 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.005</radius></sphere></geometry>
        <material><ambient>0.55 0.50 0.10 1</ambient><diffuse>0.75 0.68 0.15 1</diffuse></material>
      </visual>
    </link>
    <link name="aphid_d"><pose>0.155 -0.045 0.715 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.005</radius></sphere></geometry>
        <material><ambient>0.55 0.50 0.10 1</ambient><diffuse>0.75 0.68 0.15 1</diffuse></material>
      </visual>
    </link>

    <!-- A caterpillar resting on a leaf (small green elongated cylinder) -->
    <link name="caterpillar">
      <pose>-0.10 0.05 0.66 0 1.5708 0.3</pose>
      <visual name="v"><geometry><cylinder><radius>0.010</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.40 0.55 0.12 1</ambient><diffuse>0.55 0.72 0.18 1</diffuse></material>
      </visual>
    </link>

    <!-- Fruits: 1 healthy red, 1 rotted/black, 1 unripe with blight -->
    <link name="fruit_healthy"><pose>0.10 0.02 0.95 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.040</radius></sphere></geometry>
        <material><ambient>0.75 0.10 0.05 1</ambient><diffuse>0.95 0.18 0.08 1</diffuse><specular>0.4 0.1 0.1 1</specular></material>
      </visual>
      <collision name="c"><geometry><sphere><radius>0.040</radius></sphere></geometry></collision>
    </link>
    <link name="fruit_rotted"><pose>-0.08 -0.05 0.88 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.038</radius></sphere></geometry>
        <material><ambient>0.18 0.10 0.05 1</ambient><diffuse>0.28 0.16 0.08 1</diffuse></material>           <!-- blackened rot -->
      </visual>
      <collision name="c"><geometry><sphere><radius>0.038</radius></sphere></geometry></collision>
    </link>
    <link name="fruit_blighted"><pose>0.08 -0.08 1.08 0 0 0</pose>
      <visual name="v"><geometry><sphere><radius>0.036</radius></sphere></geometry>
        <material><ambient>0.40 0.45 0.12 1</ambient><diffuse>0.55 0.55 0.18 1</diffuse></material>           <!-- sickly yellow-green -->
      </visual>
      <collision name="c"><geometry><sphere><radius>0.036</radius></sphere></geometry></collision>
    </link>

    <!-- Joints -->
    <joint name="j_stake" type="fixed"><parent>pot</parent><child>stake</child></joint>
    <joint name="j_soil"  type="fixed"><parent>pot</parent><child>pot_soil</child></joint>
    <joint name="j_sl"    type="fixed"><parent>stake</parent><child>stem_lower</child></joint>
    <joint name="j_su"    type="fixed"><parent>stake</parent><child>stem_upper</child></joint>
    <joint name="j_lh_l"  type="fixed"><parent>stake</parent><child>leaves_healthy_l</child></joint>
    <joint name="j_lh_r"  type="fixed"><parent>stake</parent><child>leaves_healthy_r</child></joint>
    <joint name="j_lb"    type="fixed"><parent>stake</parent><child>leaves_blighted</child></joint>
    <joint name="j_lt"    type="fixed"><parent>stake</parent><child>leaves_top</child></joint>
    <joint name="j_sp1"   type="fixed"><parent>stake</parent><child>spot_1</child></joint>
    <joint name="j_sp2"   type="fixed"><parent>stake</parent><child>spot_2</child></joint>
    <joint name="j_sp3"   type="fixed"><parent>stake</parent><child>spot_3</child></joint>
    <joint name="j_a1"    type="fixed"><parent>stake</parent><child>aphid_a</child></joint>
    <joint name="j_a2"    type="fixed"><parent>stake</parent><child>aphid_b</child></joint>
    <joint name="j_a3"    type="fixed"><parent>stake</parent><child>aphid_c</child></joint>
    <joint name="j_a4"    type="fixed"><parent>stake</parent><child>aphid_d</child></joint>
    <joint name="j_cat"   type="fixed"><parent>stake</parent><child>caterpillar</child></joint>
    <joint name="j_fh"    type="fixed"><parent>stake</parent><child>fruit_healthy</child></joint>
    <joint name="j_fr"    type="fixed"><parent>stake</parent><child>fruit_rotted</child></joint>
    <joint name="j_fb"    type="fixed"><parent>stake</parent><child>fruit_blighted</child></joint>
  </model>
</sdf>
