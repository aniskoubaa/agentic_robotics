<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>agr_tb_bringup</name>
  <version>0.1.0</version>
  <description>Starts the official TurtleBot 3 and TurtleBot 4 simulators; adds nothing of its own.</description>
  <maintainer email="anis.koubaa@gmail.com">Anis Koubaa</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>agr_tb_tools</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>turtlebot4_gz_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
